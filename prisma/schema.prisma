generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "library"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Workspace {
  id           String        @id @default(cuid())
  title        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  documents    Document[]
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioAssets StudioAsset[]

  @@index([userId])
}

model Message {
  id          String    @id @default(cuid())
  role        String
  text        String
  createdAt   DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Document {
  id          String          @id @default(cuid())
  name        String // The original file name (e.g., 'ForexCoachings.docx')
  url         String // The Supabase public storage URL or YouTube URL
  sourceType  String          @default("file") // e.g., "file" or "youtube"
  textContent String? // Raw text content
  fileSize    Int? // Size in bytes
  createdAt   DateTime        @default(now())
  category    String?
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]
  studyGuides StudyGuide[]
  highlights  Highlight[]
  readingProgress ReadingProgress[]

  @@index([workspaceId])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  content    String
  embedding  Unsupported("vector(768)")?
  pageNumber Int?
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // The vector index (HNSW, cosine) is created in SQL: see prisma/migrations/*_security_and_vector_index.

  @@index([documentId])
}

model User {
  id               String        @id @default(cuid()) // Will store Supabase Auth UUID
  email            String        @unique
  username         String?
  school           String?
  department       String?
  stripeCustomerId String?       @unique
  planTier         String        @default("FREE")
  // When a paid plan lapses back to Free. Null means it does not expire (for example a plan you granted by hand).
  planExpiresAt    DateTime?
  // Set when staff pause an account. A paused account can still read, but cannot use AI, uploads or audio.
  suspendedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  workspaces       Workspace[]
  timetables       Timetable[]
  studyGuides      StudyGuide[]
  studyGoals       StudyGoal[]
  dailyMetrics     DailyMetric[]
  auditLogs        AuditLog[]
  studyGuideProgress StudyGuideProgress[]
  highlights       Highlight[]
  readingProgress  ReadingProgress[]
  cardStates       CardState[]
  quizAttempts     QuizAttempt[]
  exams            Exam[]
  usageEvents      UsageEvent[]
  creditEntries    CreditLedger[]
  staff            StaffMember?
  payments         Payment[]
  redemptions      InviteRedemption[]
  preferences      UserPreferences?
  profile          Json?
}

model Timetable {
  id     String @id @default(cuid())
  userId String
  data   Json // Store the timetable object here
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyGuide {
  id                 String   @id @default(cuid())
  userId             String
  sourceDocumentId   String
  sourceDocumentName String?
  sectionConstraint  String?
  markdownContent    String?
  title              String?
  strategyData       Json?
  isPublic           Boolean  @default(false)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document           Document @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  progress           StudyGuideProgress[]

  @@index([userId])
  @@index([sourceDocumentId])
}

model ExtractedFormCache {
  hash      String   @id
  courses   Json
  createdAt DateTime @default(now())
}

model StudioAsset {
  id          String    @id @default(uuid())
  workspaceId String
  title       String
  type        String // 'FLASHCARD', 'MINDMAP', 'PRESENTATION', 'AUDIO'
  content     Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cardStates  CardState[]
  quizAttempts QuizAttempt[]

  @@index([workspaceId])
}

model StudyGoal {
  id          String   @id @default(cuid())
  title       String // e.g., "Master EDM 205"
  targetDate  DateTime
  targetHours Int // Goal for focus hours
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyMetric {
  id              String   @id @default(cuid())
  date            DateTime @default(now()) // Stored as midnight for easy querying
  focusMinutes    Int      @default(0)
  tasksCompleted  Int      @default(0)
  averageAccuracy Float    @default(0.0) // From knowledge checks
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId]) // One record per user per day
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  details   String   @db.Text
  ipAddress String?
  location  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StudyGuideProgress {
  id          String   @id @default(cuid())
  userId      String
  guideId     String
  phaseId     String
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide       StudyGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([userId, guideId, phaseId])
}

model UserPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  theme           String   @default("system")
  sidebarMode     String   @default("expanded")
  dailyFocusGoal  Int      @default(120)
  guideComplexity String   @default("standard")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A passage the reader saved while studying a source, with an optional note.
model Highlight {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  quote      String   @db.Text
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, documentId])
}

// How far through a source the reader got (0 to 1), so it can resume and the Library can show it.
model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  progress   Float    @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
}

// Spaced-repetition state for one card of a saved flashcard set. Cards with no row are new.
model CardState {
  id             String      @id @default(cuid())
  userId         String
  assetId        String
  cardIndex      Int
  ease           Float       @default(2.5)
  intervalDays   Int         @default(0)
  reps           Int         @default(0)
  lapses         Int         @default(0)
  correct        Int         @default(0)
  total          Int         @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset          StudioAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId, cardIndex])
  @@index([userId, dueAt])
}

// One finished run of a quiz. Keeps its score if the quiz itself is later deleted.
model QuizAttempt {
  id        String       @id @default(cuid())
  userId    String
  assetId   String?
  title     String
  score     Int
  total     Int
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     StudioAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// An upcoming exam and the sources it covers. Study plans are worked out from this.
model Exam {
  id          String   @id @default(cuid())
  userId      String
  title       String
  examDate    DateTime
  documentIds String[]
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examDate])
}

// One metered action (a chat message, a generated item, minutes of voiced audio...).
// includedUnits came out of the plan's monthly allowance; credits were spent for the rest.
model UsageEvent {
  id            String   @id @default(cuid())
  userId        String
  kind          String
  units         Int      @default(1)
  includedUnits Int      @default(0)
  credits       Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

// Every change to a user's credit balance: purchases and grants are positive, spending is negative.
// The balance is the sum of amount. ref is unique so a payment or grant can never be applied twice.
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // PURCHASE, GRANT, USAGE, PLAN, REFUND
  ref       String?  @unique
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A moderator or other team member. The owner is not a row here: owners come from ADMIN_EMAILS.
// permissions holds the keys from lib/staff.ts that this person may use; anything not listed is hidden from them.
model StaffMember {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions String[]
  addedById   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A real payment from Paystack, kept for finance reporting even if the user is later deleted.
model Payment {
  id         String   @id @default(cuid())
  userId     String?
  reference  String   @unique
  product    String
  amountNgn  Int
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// A code that gives a tester credits and/or a plan when they redeem it.
model Invite {
  id          String             @id @default(cuid())
  code        String             @unique
  note        String?
  credits     Int                @default(0)
  planTier    String?
  planDays    Int?
  maxUses     Int                @default(1)
  uses        Int                @default(0)
  expiresAt   DateTime?
  active      Boolean            @default(true)
  createdById String?
  createdAt   DateTime           @default(now())
  redemptions InviteRedemption[]
}

model InviteRedemption {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String
  createdAt DateTime @default(now())
  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
}

// What it costs to run the business, entered by hand: hosting, domains, services. Feeds the funds and runway view.
model Expense {
  id          String   @id @default(cuid())
  label       String
  category    String
  amountNgn   Int
  incurredOn  DateTime
  recurring   String? // "monthly", "yearly" or empty for a one-off
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([incurredOn])
}

// Live switches and settings the owner can change without a deploy (kill switches, maintenance message).
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}
