DATABASE_URL=
DIRECT_URL=
GEMINI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed to delete a user's login when they delete their account.
SUPABASE_SERVICE_ROLE_KEY=

# Audio overviews. With no key, episodes are saved as a transcript only and nothing is spent.
ELEVENLABS_API_KEY=
# Set to "off" to switch voices off even when a key is present.
AUDIO_PROVIDER=
# Cheapest model per character. Override only after listening to the difference.
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional voice ids for the two hosts (defaults are free premade voices).
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=
# The most voiced characters the whole app may spend in a month (about 900 characters per minute of audio).
AUDIO_MONTHLY_CHARS=40000

# Accounts allowed to open /admin to give credits or set plans (comma-separated emails). Empty means nobody.
ADMIN_EMAILS=
# Paystack secret key (Settings > API keys). Without it, buying is switched off and the plan screen says so.
# In the Paystack dashboard, set the webhook URL to https://YOUR-DOMAIN/api/billing/webhook
PAYSTACK_SECRET_KEY=
